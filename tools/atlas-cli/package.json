{
  "name": "atlas-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas Validator & Generator (P1) — verifies Atlas conventions and scaffolds Knowledge Objects.",
  "bin": {
    "atlas": "src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "tsx src/cli.ts validate ../../vault-prototype",
    "id": "tsx src/cli.ts id",
    "new": "tsx src/cli.ts new --vault ../../vault-prototype",
    "index": "tsx src/cli.ts index ../../vault-prototype",
    "context": "tsx scripts/context.ts",
    "activation": "tsx src/cli.ts activation ../../vault-prototype",
    "health": "npm run validate && npm run index && npm run activation"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0"
  }
}
